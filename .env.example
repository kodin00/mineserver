# Change this before the first start to use your own password (at least 12 characters).
ADMIN_PASSWORD=mineserver123!

# Panel HTTP port. Put an HTTPS reverse proxy in front for remote access.
PANEL_PORT=8080
COOKIE_SECURE=false

# This host path is mounted into the API at the same absolute path so sibling
# Minecraft containers can resolve generated bind mounts through the host daemon.
MINESERVER_DATA_ROOT=/opt/mineserver

TZ=Asia/Jakarta
SESSION_TTL_HOURS=24
# Bundled nginx is the API's only trusted reverse-proxy hop.
TRUST_PROXY_HOPS=1
# One-time add-on links expire unused after this many minutes.
ADDON_SHARE_TTL_MINUTES=60
# Public add-on download attempts allowed per client IP per minute.
PUBLIC_DOWNLOAD_RATE_LIMIT=10
MAX_UPLOAD_BYTES=2147483648
# Maximum number of JAR/ZIP files in one upload request.
MAX_UPLOAD_FILES=100
MAX_ZIP_EXPANDED_BYTES=4294967296
MAX_ZIP_FILES=500
# Maximum UTF-8 text file size that can be opened in the browser editor.
MAX_EDIT_FILE_BYTES=1048576
# Marketplace contact details and the optional Modrinth access token are set in
# the panel under Settings, not here.
# This only seeds the initial on/off state the first time the panel starts.
MODRINTH_ENABLED=true
# Modrinth requires a uniquely identifying User-Agent. Change it if you fork.
# Contact details entered under Settings replace the parenthetical below.
MODRINTH_USER_AGENT=kodin00/mineserver-panel/0.1.0 (github.com/kodin00/mineserver)
# Modrinth allows 300 requests per minute per IP. Stay well under it.
MODRINTH_REQUESTS_PER_MINUTE=120
MODRINTH_API_TIMEOUT_MS=10000
MODRINTH_DOWNLOAD_TIMEOUT_MS=120000
# Largest single file the panel will download from the Modrinth CDN (512 MiB).
MODRINTH_MAX_FILE_BYTES=536870912
# Largest number of files allowed inside one datapack ZIP.
MODRINTH_MAX_DATAPACK_FILES=20000
